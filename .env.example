# ============================================================
# VARIABLES DE ENTORNO - Ejecutar: cp .env.example .env
# Este archivo documenta todas las variables requeridas por la app.
# ============================================================

# --- Aplicación ---
PORT=3000
NODE_ENV=development

# --- PostgreSQL ---
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce_secret
POSTGRES_DB=ecommerce_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT ---
# Secreto del Access Token (vida corta). Usar valor aleatorio largo en producción.
JWT_ACCESS_SECRET=change_me_access_secret_random_string
# Secreto del Refresh Token (vida larga). Debe ser DISTINTO del access secret.
JWT_REFRESH_SECRET=change_me_refresh_secret_random_string
# Tiempos de expiración (formato de jsonwebtoken: 15m, 7d, etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Cookies ---
# secure=true solo en producción (HTTPS). sameSite: strict|lax|none
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict

# --- CORS ---
# Orígenes permitidos separados por coma. Se añade automáticamente el origen
# de la propia API para que Scalar UI (/docs) funcione en el mismo dominio.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# --- Seeders ---
# Si es "true", inserta datos iniciales (admin, client, categorías, productos)
# cuando la base de datos está vacía.
SEED_ON_BOOT=true
